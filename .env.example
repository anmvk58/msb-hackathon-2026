# Application
APP_NAME=MSB Financial Radar
APP_ENV=development
DATABASE_URL=sqlite:///./financial_radar.db
SQL_ECHO=false
SPENDING_ANOMALY_THRESHOLD=0.20
SPENDING_BASELINE_MONTHS=3
RECURRING_LOOKAHEAD_DAYS=14
CASHFLOW_SPENDING_LOOKBACK_DAYS=30
CASHFLOW_MEDIUM_RATIO=0.50
SHOPPING_BUDGET_INCOME_RATIO=0.16

# Provider-neutral LLM configuration (not required for Phase 1-2)
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

# GreenNode integration point; exact SDK/auth contract is intentionally unspecified
GREENNODE_BASE_URL=
GREENNODE_API_KEY=
GREENNODE_MODEL=
GREENNODE_AGENT_ID=
