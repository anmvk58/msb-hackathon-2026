# Application
APP_NAME="MSB Financial Sensing"
APP_ENV=development
AGENT_RUNTIME=local
DATABASE_URL=postgresql+psycopg://financial_radar:financial_radar@localhost:5433/financial_radar
FINANCIAL_RADAR_DB_NAME=financial_radar
FINANCIAL_RADAR_DB_USER=financial_radar
FINANCIAL_RADAR_DB_PASSWORD=financial_radar
SQL_ECHO=false
CORE_BANKING_BASE_URL=http://localhost:8090
CORE_BANKING_TIMEOUT_SECONDS=10
CORE_BANKING_API_KEY=
SPENDING_ANOMALY_THRESHOLD=0.20
SPENDING_BASELINE_MONTHS=3
RECURRING_LOOKAHEAD_DAYS=14
CASHFLOW_SPENDING_LOOKBACK_DAYS=30
CASHFLOW_MEDIUM_RATIO=0.50
SHOPPING_BUDGET_INCOME_RATIO=0.16

# GreenNode MaaS authentication (separate from AgentBase IAM credentials)
LLM_PROVIDER=greennode
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_STRUCTURED_RETRIES=2
AGENT_RECOMMENDATION_TTL_SECONDS=900
SCHEDULER_INTERVAL_SECONDS=180
SCHEDULER_CUSTOMER_IDS=C001,C002,C003,C004

# Deployment/lifecycle only. AgentBase skills use these outside the app process.
# AgentBase Runtime may inject them, but this FastAPI app does not require them.
GREENNODE_CLIENT_ID=
GREENNODE_CLIENT_SECRET=

# Runtime metadata auto-injected by AgentBase after deployment; do not set manually.
GREENNODE_AGENT_IDENTITY=
GREENNODE_ENDPOINT_URL=

# Real integration tests are opt-in
RUN_GREENNODE_INTEGRATION_TESTS=false

# Mock Core Banking service (separate process, port 8090)
CORE_BANKING_DATABASE_URL=mysql+pymysql://corebanking:corebanking@localhost:3306/corebanking?charset=utf8mb4
CORE_BANKING_SEED_DEMO_ON_START=true
CORE_BANKING_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
