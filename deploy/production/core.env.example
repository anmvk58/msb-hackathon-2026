# Copy to core.env on the Core Banking server. Never commit core.env.
CORE_BIND_IP=10.0.0.10
# URL-encode special characters in the password. Configure DB TLS in this URL.
CORE_BANKING_DATABASE_URL=mysql+pymysql://core_user:CHANGE_ME@mysql-private-host:3306/corebanking?charset=utf8mb4
CORE_BANKING_CORS_ORIGINS=https://mobile.example.com
CORE_BANKING_SEED_DEMO_ON_START=false
ADMIN_CORE_BANKING_TIMEOUT_SECONDS=10
